#!/bin/sh
set -eu

case "${1:-remove}" in
  remove|purge)
    # prerm removes the web-SAPI ini and reloads active stacks before dpkg
    # deletes the referenced PHP library. postrm has no safe library left to
    # repeat that operation; only refresh systemd metadata here.
    systemctl daemon-reload >/dev/null 2>&1 || true
    ;;
esac

# Do not remove /var/lib/asterisk/pendingchanges-watcher. It contains the
# operator's local evidence and must remain recoverable after package removal.
