#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo 'Run as root.' >&2
  exit 1
fi

target=
for candidate in /etc/php/*/apache2/conf.d; do
  if [ -d "$candidate" ]; then
    target=$candidate
  fi
done
if [ -z "$target" ]; then
  echo 'No Apache PHP conf.d directory was found.' >&2
  exit 1
fi

install -d -o asterisk -g asterisk -m 0750 /var/lib/asterisk/pendingchanges-attribution
install -o root -g root -m 0644 \
  /usr/lib/what-changed-watcher/99-what-changed-attribution.ini \
  "$target/99-what-changed-attribution.ini"
apachectl configtest
systemctl reload apache2
