#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo 'Run as root.' >&2
  exit 1
fi

append_target() {
  case " $targets " in
    *" $1 "*) : ;;
    *) targets="$targets $1" ;;
  esac
}

# Install only into web SAPIs. Debian keeps Apache and FPM configuration in
# separate trees. RHEL-derived FreePBX distributions commonly use /etc/php.d
# for the active web SAPI as well as CLI, so retain that compatibility path.
targets=
for candidate in /etc/php/*/apache2/conf.d /etc/php/*/fpm/conf.d /etc/php.d; do
  [ -d "$candidate" ] && append_target "$candidate"
done
if [ -z "$targets" ]; then
  echo 'No supported Apache or PHP-FPM web-SAPI configuration directory was found.' >&2
  echo 'The core watcher remains usable, but administrator request attribution is unavailable.' >&2
  exit 0
fi

# PHP permits only one auto_prepend_file. Silently replacing a security agent
# or site bootstrap would be an unsafe host-wide side effect, so detect any
# pre-existing directive before writing WhatChanged's deliberately last-sorted
# ini. Report paths only; configuration values may themselves be sensitive.
prepend_conflicts=
append_conflict() {
  case " $prepend_conflicts " in
    *" $1 "*) : ;;
    *) prepend_conflicts="$prepend_conflicts $1" ;;
  esac
}
for target in $targets; do
  main_ini=$(dirname "$target")/php.ini
  for candidate in "$main_ini" "$target"/*.ini; do
    [ -f "$candidate" ] || continue
    [ "$(basename "$candidate")" != 99-what-changed-attribution.ini ] || continue
    if grep -Eq '^[[:space:]]*auto_prepend_file[[:space:]]*=[[:space:]]*[^[:space:]]' "$candidate"; then
      append_conflict "$candidate"
    fi
  done
done
if [ -f /etc/php.ini ] \
    && grep -Eq '^[[:space:]]*auto_prepend_file[[:space:]]*=[[:space:]]*[^[:space:]]' /etc/php.ini; then
  append_conflict /etc/php.ini
fi

# PHP-FPM pools and Apache virtual hosts can set the same directive outside
# php.ini. Scan only active configuration locations and report paths, never
# the configured value.
for candidate in /etc/php/*/fpm/pool.d/*.conf; do
  [ -f "$candidate" ] || continue
  if grep -Eq '^[[:space:]]*php_(admin_)?value\[auto_prepend_file\][[:space:]]*=[[:space:]]*[^[:space:]]' "$candidate"; then
    append_conflict "$candidate"
  fi
done
for candidate in /etc/apache2/apache2.conf /etc/apache2/conf-enabled/*.conf \
    /etc/apache2/sites-enabled/*.conf /etc/httpd/conf/httpd.conf /etc/httpd/conf.d/*.conf; do
  [ -f "$candidate" ] || continue
  if grep -Eq '^[[:space:]]*php_(admin_)?value[[:space:]]+auto_prepend_file[[:space:]]+[^[:space:]]' "$candidate"; then
    append_conflict "$candidate"
  fi
done

module_path=/var/www/html/admin/modules
if [ -r /etc/what-changed-watcher.env ]; then
  configured_module_path=$(sed -n 's/^MODULE_PATH=//p' /etc/what-changed-watcher.env | tail -n 1)
  case "$configured_module_path" in
    /*) module_path=$configured_module_path ;;
  esac
fi
freepbx_webroot=${module_path%/admin/modules}
for candidate in "$freepbx_webroot/.user.ini" "$freepbx_webroot/admin/.user.ini"; do
  [ -f "$candidate" ] || continue
  if grep -Eq '^[[:space:]]*auto_prepend_file[[:space:]]*=[[:space:]]*[^[:space:]]' "$candidate"; then
    append_conflict "$candidate"
  fi
done
if [ -n "$prepend_conflicts" ]; then
  echo 'WhatChanged did not install its administrator request sensor because another auto_prepend_file is active.' >&2
  for conflict in $prepend_conflicts; do
    echo "conflicting_configuration=$conflict" >&2
  done
  echo 'The core database/file watcher remains usable, but administrator attribution is unavailable.' >&2
  echo 'Review the existing prepend integration, then rerun this installer; do not delete another product configuration blindly.' >&2
  # Exit 3 is a deliberate degraded outcome, not a failed core watcher
  # installation. Package/module installers recognize it and continue while
  # leaving administrator attribution disabled.
  exit 3
fi

attribution_log=/var/lib/asterisk/pendingchanges-attribution/requests.jsonl
if [ -r /etc/what-changed-watcher.env ]; then
  configured_log=$(sed -n 's/^ATTRIBUTION_LOG=//p' /etc/what-changed-watcher.env | tail -n 1)
  case "$configured_log" in
    /*) attribution_log=$configured_log ;;
  esac
fi
install -d -o asterisk -g asterisk -m 0750 "$(dirname "$attribution_log")"
sensor_source=/usr/lib/what-changed-watcher/99-what-changed-attribution.ini
if [ ! -f "$sensor_source" ]; then
  sensor_source=/usr/local/lib/what-changed-watcher/99-what-changed-attribution.ini
fi
for target in $targets; do
  install -o root -g root -m 0644 \
    "$sensor_source" \
    "$target/99-what-changed-attribution.ini"
  echo "sensor_configuration=$target/99-what-changed-attribution.ini"
done

systemd_active() {
  command -v systemctl >/dev/null 2>&1 \
    && systemctl is-active --quiet "$1" >/dev/null 2>&1
}
process_active() {
  command -v pgrep >/dev/null 2>&1 && pgrep -x "$1" >/dev/null 2>&1
}

apache_active=0
if systemd_active apache2.service || systemd_active httpd.service \
    || process_active apache2 || process_active httpd; then
  apache_active=1
fi
nginx_active=0
if systemd_active nginx.service || process_active nginx; then
  nginx_active=1
fi

fpm_versions=
for fpm_target in /etc/php/*/fpm/conf.d; do
  [ -d "$fpm_target" ] || continue
  version=$(printf '%s\n' "$fpm_target" | sed -n 's|^/etc/php/\([^/]*\)/fpm/conf.d$|\1|p')
  [ -n "$version" ] || continue
  if systemd_active "php${version}-fpm.service" \
      || [ -s "/run/php/php${version}-fpm.pid" ] \
      || process_active "php-fpm${version}"; then
    fpm_versions="$fpm_versions $version"
  fi
done
rhel_fpm_active=0
if [ -d /etc/php.d ] && { systemd_active php-fpm.service || process_active php-fpm; }; then
  rhel_fpm_active=1
fi

# Validate every active web stack before reloading any process. Existing
# virtual-host warnings remain visible, but a validation failure is fatal.
if [ "$apache_active" -eq 1 ]; then
  echo 'Validating the complete Apache configuration before reloading Apache.'
  apachectl configtest
fi
if [ "$nginx_active" -eq 1 ]; then
  echo 'Validating the complete nginx configuration before reloading nginx.'
  nginx -t
fi
for version in $fpm_versions; do
  echo "Validating PHP $version FPM configuration before reloading PHP-FPM."
  "php-fpm$version" -t
done
if [ "$rhel_fpm_active" -eq 1 ]; then
  echo 'Validating PHP-FPM configuration before reloading PHP-FPM.'
  php-fpm -t
fi

if [ "$apache_active" -eq 1 ]; then
  if systemd_active apache2.service; then
    systemctl reload apache2
  elif systemd_active httpd.service; then
    systemctl reload httpd
  else
    apachectl -k graceful
  fi
fi
for version in $fpm_versions; do
  if systemd_active "php${version}-fpm.service"; then
    systemctl reload "php${version}-fpm"
  elif [ -s "/run/php/php${version}-fpm.pid" ]; then
    kill -USR2 "$(cat "/run/php/php${version}-fpm.pid")"
  fi
done
if [ "$rhel_fpm_active" -eq 1 ]; then
  if systemd_active php-fpm.service; then
    systemctl reload php-fpm
  elif [ -s /run/php-fpm/php-fpm.pid ]; then
    kill -USR2 "$(cat /run/php-fpm/php-fpm.pid)"
  fi
fi
if [ "$nginx_active" -eq 1 ]; then
  if systemd_active nginx.service; then
    systemctl reload nginx
  else
    nginx -s reload
  fi
fi

if [ "$apache_active" -eq 0 ] && [ "$nginx_active" -eq 0 ] \
    && [ -z "$fpm_versions" ] && [ "$rhel_fpm_active" -eq 0 ]; then
  echo 'Sensor configuration installed; no supported web service was active to reload.'
else
  echo 'WhatChanged administrator request sensor configured for the active web stack.'
fi
