#!/bin/sh
set -eu

usage() {
  echo 'usage: what-changed-watcher-configure [--paths-only]' >&2
}

paths_only=0
case "${1:-}" in
  '') ;;
  --paths-only) paths_only=1 ;;
  -h|--help) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac

if [ "$(id -u)" -ne 0 ]; then
  echo 'Run as root.' >&2
  exit 1
fi
if [ ! -f /etc/freepbx.conf ]; then
  echo 'FreePBX configuration was not found at /etc/freepbx.conf.' >&2
  exit 1
fi

library=/usr/lib/what-changed-watcher
service=/lib/systemd/system/what-changed-watcher.service
if [ ! -f "$library/configure-database.php" ]; then
  library=/usr/local/lib/what-changed-watcher
  service=/etc/systemd/system/what-changed-watcher.service
fi
description=$(php "$library/configure-database.php" --describe)
tab=$(printf '\t')
old_ifs=$IFS
IFS=$tab
set -- $description
IFS=$old_ifs
if [ "$#" -ne 7 ]; then
  echo 'Could not determine the FreePBX database connection and filesystem layout.' >&2
  exit 1
fi
db_host=$1
db_port=$2
db_name=$3
freepbx_webroot=$4
astetc=$5
astvarlib=$6
db_socket=$7
[ "$db_socket" = - ] && db_socket=
module_path=${freepbx_webroot%/}/admin/modules
state_dir=${astvarlib%/}/pendingchanges-watcher
attribution_dir=${astvarlib%/}/pendingchanges-attribution
attribution_log=$attribution_dir/requests.jsonl
astdb_path=${astvarlib%/}/astdb.sqlite3

install -d -o asterisk -g asterisk -m 0750 "$state_dir" "$attribution_dir"

environment=/etc/what-changed-watcher.env
if [ ! -f "$environment" ]; then
  echo 'Watcher environment file is missing.' >&2
  exit 1
fi

replace_setting() {
  key=$1
  value=$2
  source=$3
  destination=$4
  escaped=$(printf '%s' "$value" | sed 's/[&|]/\\&/g')
  if grep -q "^${key}=" "$source"; then
    sed "s|^${key}=.*|${key}=${escaped}|" "$source" > "$destination"
  else
    { printf '%s=%s\n' "$key" "$value"; cat "$source"; } > "$destination"
  fi
}

update_environment() {
  key=$1
  value=$2
  next=${environment}.next.$$
  replace_setting "$key" "$value" "$environment" "$next"
  install -o root -g root -m 0600 "$next" "$environment"
  rm -f "$next"
}

update_environment DB_HOST "$db_host"
update_environment DB_PORT "$db_port"
update_environment DB_SOCKET "$db_socket"
update_environment DB_NAME "$db_name"
update_environment WATCH_PATH "$astetc"
update_environment MODULE_PATH "$module_path"
update_environment ASTDB_PATH "$astdb_path"
update_environment STATE_DIR "$state_dir"
update_environment ATTRIBUTION_LOG "$attribution_log"

template=$library/what-changed-watcher.service
if [ ! -f "$template" ]; then
  echo 'Watcher service template is missing.' >&2
  exit 1
fi
escape_sed() {
  printf '%s' "$1" | sed 's/[&|]/\\&/g'
}
escaped_library=$(escape_sed "$library")
escaped_module=$(escape_sed "$module_path")
escaped_astetc=$(escape_sed "$astetc")
escaped_astvarlib=$(escape_sed "$astvarlib")
escaped_state=$(escape_sed "$state_dir")
escaped_attribution=$(escape_sed "$attribution_dir")
service_temp=${service}.next.$$
sed \
  -e "s|/usr/local/lib/what-changed-watcher|$escaped_library|g" \
  -e "s|/var/www/html/admin/modules|$escaped_module|g" \
  -e "s|/etc/asterisk|$escaped_astetc|g" \
  -e "s|/var/lib/asterisk/pendingchanges-watcher|$escaped_state|g" \
  -e "s|/var/lib/asterisk/pendingchanges-attribution|$escaped_attribution|g" \
  -e "s|/var/lib/asterisk|$escaped_astvarlib|g" \
  "$template" > "$service_temp"
install -o root -g root -m 0644 "$service_temp" "$service"
rm -f "$service_temp"

systemctl daemon-reload
if [ "$paths_only" -eq 1 ]; then
  echo 'WhatChanged watcher paths synchronized with FreePBX settings.'
  exit 0
fi

case "$db_name" in
  ''|*[!A-Za-z0-9_]*)
    echo 'FreePBX AMPDBNAME contains characters that cannot be granted safely.' >&2
    exit 1
    ;;
esac

configured_db_user=$(sed -n 's/^DB_USER=//p' "$environment" | tail -n 1)
configured_db_password=$(sed -n 's/^DB_PASSWORD=//p' "$environment" | tail -n 1)
reviewed_database_account=0
if [ "$configured_db_user" != what_changed_watcher ]; then
  reviewed_database_account=1
elif [ -n "$configured_db_password" ] \
    && [ "$configured_db_password" != replace-with-generated-secret ] \
    && ! printf '%s\n' "$configured_db_password" | grep -Eq '^[0-9a-f]{64}$'; then
  reviewed_database_account=1
fi
if [ "$reviewed_database_account" -eq 1 ]; then
  echo 'Preserving the reviewed administrator-supplied watcher database account; automatic credentials and grants were not changed.'
  systemctl enable --now what-changed-watcher.service
  exit 0
fi

if [ -z "$db_socket" ]; then
  case "$db_host" in
    localhost|127.0.0.1) ;;
    *)
      echo 'Automatic setup supports only a local MariaDB server. Configure a reviewed SELECT-only account manually for remote MariaDB.' >&2
      exit 1
      ;;
  esac
fi

secret=$configured_db_password
if ! printf '%s\n' "$secret" | grep -Eq '^[0-9a-f]{64}$'; then
  secret=$(python3 -c 'import secrets; print(secrets.token_hex(32))')
fi
if command -v mariadb >/dev/null 2>&1; then
  mysql_client=mariadb
elif command -v mysql >/dev/null 2>&1; then
  mysql_client=mysql
else
  echo 'Neither the mariadb nor mysql client was found.' >&2
  exit 1
fi

watch_tables=$(sed -n 's/^WATCH_TABLES=//p' "$environment" | tail -n 1)
if [ -z "$watch_tables" ]; then
  echo 'WATCH_TABLES is empty; refusing to create a database account with ambiguous scope.' >&2
  exit 1
fi
grant_tables=admin
old_ifs=$IFS
IFS=,
set -- $watch_tables
IFS=$old_ifs
for table in "$@"; do
  case "$table" in
    ''|*[!A-Za-z0-9_]*)
      echo "WATCH_TABLES contains an unsafe table name: $table" >&2
      exit 1
      ;;
  esac
  case " $grant_tables " in
    *" $table "*) ;;
    *) grant_tables="$grant_tables $table" ;;
  esac
done

# Root's local MariaDB socket is used only to create/update this dedicated
# account. The watcher itself receives SELECT and nothing else, and follows
# FreePBX's configured AMPDBSOCK when present or AMPDBPORT for TCP.
set -- --protocol=socket
if [ -n "$db_socket" ]; then
  set -- "$@" "--socket=$db_socket"
fi
existing_tables=$("$mysql_client" "$@" --batch --skip-column-names \
  --execute="SELECT TABLE_NAME FROM information_schema.TABLES WHERE TABLE_SCHEMA = '$db_name'")
grant_file=$(mktemp /tmp/what-changed-watcher-grants.XXXXXX)
trap 'rm -f "$grant_file"' EXIT HUP INT TERM
chmod 0600 "$grant_file"
{
  printf "CREATE USER IF NOT EXISTS 'what_changed_watcher'@'localhost' IDENTIFIED BY '%s';\n" "$secret"
  printf "ALTER USER 'what_changed_watcher'@'localhost' IDENTIFIED BY '%s';\n" "$secret"
  printf "REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'what_changed_watcher'@'localhost';\n"
  printf "CREATE USER IF NOT EXISTS 'what_changed_watcher'@'127.0.0.1' IDENTIFIED BY '%s';\n" "$secret"
  printf "ALTER USER 'what_changed_watcher'@'127.0.0.1' IDENTIFIED BY '%s';\n" "$secret"
  printf "REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'what_changed_watcher'@'127.0.0.1';\n"
  for table in $grant_tables; do
    if printf '%s\n' "$existing_tables" | grep -Fxq "$table"; then
      printf 'GRANT SELECT ON `%s`.`%s` TO '\''what_changed_watcher'\''@'\''localhost'\'';\n' "$db_name" "$table"
      printf 'GRANT SELECT ON `%s`.`%s` TO '\''what_changed_watcher'\''@'\''127.0.0.1'\'';\n' "$db_name" "$table"
    fi
  done
  printf 'FLUSH PRIVILEGES;\n'
} > "$grant_file"
"$mysql_client" "$@" < "$grant_file"
rm -f "$grant_file"
trap - EXIT HUP INT TERM

# Once MariaDB has accepted the credential, persist the matching value before
# secondary grant verification. A later verification failure must not leave
# the running watcher holding a password that no longer works.
update_environment DB_USER what_changed_watcher
update_environment DB_PASSWORD "$secret"

for host in localhost 127.0.0.1; do
  grants=$("$mysql_client" "$@" --batch --skip-column-names \
    --execute="SHOW GRANTS FOR 'what_changed_watcher'@'$host'")
  if printf '%s\n' "$grants" | grep -Fq "\`$db_name\`.*"; then
    echo "Watcher account $host still has schema-wide access; refusing to continue." >&2
    exit 1
  fi
done
systemctl enable --now what-changed-watcher.service
echo 'WhatChanged watcher configured with SELECT access only to existing allowlisted tables.'
