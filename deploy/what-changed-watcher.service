[Unit]
Description=WhatChanged FreePBX pending-change watcher
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=asterisk
Group=asterisk
EnvironmentFile=/etc/what-changed-watcher.env
Environment=PROBE_INTERVAL=5
Environment=FULL_SCAN_INTERVAL=30
Environment=MODULE_SCAN_INTERVAL=300
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/local/lib/what-changed-watcher/watcher.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ReadWritePaths=/var/lib/asterisk/pendingchanges-watcher
ReadOnlyPaths=/etc/asterisk /var/lib/asterisk /var/www/html/admin/modules /var/lib/asterisk/pendingchanges-attribution

[Install]
WantedBy=multi-user.target
