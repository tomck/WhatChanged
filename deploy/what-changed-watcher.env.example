DB_HOST=localhost
DB_USER=what_changed_watcher
DB_PASSWORD=replace-with-generated-secret
DB_NAME=asterisk
# Comma-separated FreePBX configuration-table allowlist. Do not add CDR, CEL,
# queue_log, or other call/log tables.
WATCH_TABLES=announcement,callbacks,conferences,customappsreg,devices,did,extension_routes,extensions,featurecodes,freepbx_settings,globals,iax,injected,ivr_details,ivr_entries,miscapps,miscdests,outbound_route_patterns,outbound_route_sequence,outbound_route_sequences,outbound_route_trunks,outbound_routes,parkinglot,pjsip,queues_config,queues_details,queues_members,ringgroups,sip,sipsettings,kvstore_Sipsettings,timeconditions,timegroups,timegroups_details,trunk_dialpatterns,trunks,users,zap
# A watched table above this size is reported as a coverage limitation and is
# never read into the baseline.
MAX_TABLE_ROWS=5000
# Per-table exceptions are explicit. `sip` stores current endpoint settings
# as one row per setting and is safe to cover at this practical ceiling.
TABLE_ROW_LIMITS=sip=20000
