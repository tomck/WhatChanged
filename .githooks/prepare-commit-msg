#!/usr/bin/env bash

set -euo pipefail

message_file=${1:?prepare-commit-msg requires a commit message file}

# Ordinary human-created commits are deliberately untouched. AI-assisted
# commits must go through scripts/ai-commit.sh (or the codex-commit.sh /
# claude-commit.sh wrappers), which supply this gate and the provenance
# values below. CODEX_COMMIT* variables remain accepted for compatibility.
if [[ ${AI_COMMIT:-${CODEX_COMMIT:-0}} != 1 ]]; then
    exit 0
fi

agent=${AI_COMMIT_AGENT:-Codex}
model=${AI_COMMIT_MODEL:-${CODEX_COMMIT_MODEL:-}}
effort=${AI_COMMIT_EFFORT:-${CODEX_COMMIT_REASONING_EFFORT:-}}
agent_version=${AI_COMMIT_AGENT_VERSION:-}
thread=${AI_COMMIT_THREAD:-${CODEX_COMMIT_THREAD_ID:-}}

validate_value() {
    local name=$1
    local value=$2

    if [[ -z $value ]]; then
        echo "prepare-commit-msg: ${name} must not be empty" >&2
        exit 1
    fi

    if [[ $value == *$'\n'* || $value == *$'\r'* ]]; then
        echo "prepare-commit-msg: ${name} must be a single line" >&2
        exit 1
    fi
}

add_trailer() {
    git interpret-trailers --in-place \
        --if-exists=replace \
        --if-missing=add \
        --trailer "$1: $2" \
        "$message_file"
}

validate_value AI_COMMIT_AGENT "$agent"
validate_value AI_COMMIT_MODEL "$model"

add_trailer Assisted-by "${agent}:${model}"

if [[ -n $agent_version ]]; then
    validate_value AI_COMMIT_AGENT_VERSION "$agent_version"
    add_trailer Agent-Version "$agent_version"
fi

if [[ -n $effort ]]; then
    validate_value AI_COMMIT_EFFORT "$effort"
    add_trailer Reasoning-Effort "$effort"
fi

if [[ -n $thread ]]; then
    validate_value AI_COMMIT_THREAD "$thread"
    add_trailer Agent-Thread "$thread"
fi
