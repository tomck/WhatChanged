#!/bin/sh
# Install the watcher payload embedded in the Pending Changes module.
# This never runs implicitly from Module Admin: the OS-level changes require
# an explicit root command after the module has been installed.
set -eu

usage() {
  echo 'usage: install-watcher [--check] [--layout debian|portable]' >&2
}

layout=auto
check_only=0
test_mode=${WHAT_CHANGED_INSTALL_TESTING:-0}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --check) check_only=1; shift ;;
    --layout)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      layout=$2
      shift 2
      ;;
    --layout=*) layout=${1#*=}; shift ;;
    debian|portable) layout=$1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

module_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
payload=$module_dir/watcher
required='VERSION watcher.py what-changed-request-audit.php 99-what-changed-attribution.ini configure-database.php what-changed-watcher-configure what-changed-watcher-install-sensor what-changed-watcher.service what-changed-watcher.env'
for file in $required; do
  if [ ! -f "$payload/$file" ]; then
    echo "Embedded watcher payload is incomplete: missing $file." >&2
    exit 1
  fi
done
embedded_version=$(tr -d '[:space:]' < "$payload/VERSION")
if ! printf '%s\n' "$embedded_version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo 'Embedded watcher VERSION is invalid.' >&2
  exit 1
fi

test_root=${WHAT_CHANGED_INSTALL_ROOT:-}
test_webroot=${WHAT_CHANGED_INSTALL_WEBROOT:-}
test_astetc=${WHAT_CHANGED_INSTALL_ASTETCDIR:-}
test_astvarlib=${WHAT_CHANGED_INSTALL_ASTVARLIBDIR:-}
test_dbport=${WHAT_CHANGED_INSTALL_DBPORT:-}
test_dbsock=${WHAT_CHANGED_INSTALL_DBSOCK:-}
test_pymysql=${WHAT_CHANGED_PYMYSQL_STATE:-}
test_answer=${WHAT_CHANGED_INSTALL_PROMPT_RESPONSE:-}
if { [ -n "$test_root" ] || [ -n "$test_webroot" ] || [ -n "$test_astetc" ] \
    || [ -n "$test_astvarlib" ] || [ -n "$test_dbport" ] || [ -n "$test_dbsock" ] \
    || [ -n "$test_pymysql" ] || [ -n "$test_answer" ]; } \
    && [ "$test_mode" != 1 ]; then
  echo 'WHAT_CHANGED_INSTALL_* overrides are reserved for the repository test gate.' >&2
  exit 1
fi

target() {
  printf '%s%s' "$test_root" "$1"
}

os_release=${WHAT_CHANGED_OS_RELEASE:-/etc/os-release}
if [ "$os_release" != /etc/os-release ] && [ "$test_mode" != 1 ]; then
  echo 'WHAT_CHANGED_OS_RELEASE is reserved for the repository test gate.' >&2
  exit 1
fi
os_id=$(sed -n 's/^ID=//p' "$os_release" 2>/dev/null | head -n 1 | tr -d '"' || true)
os_like=$(sed -n 's/^ID_LIKE=//p' "$os_release" 2>/dev/null | head -n 1 | tr -d '"' || true)
case " $os_id $os_like " in
  *debian*|*ubuntu*) os_family=debian ;;
  *rhel*|*fedora*|*centos*|*rocky*|*almalinux*|*sangoma*) os_family=rhel ;;
  *) os_family=unknown ;;
esac

if [ "$layout" = auto ]; then
  existing_service=
  for candidate in \
    /etc/systemd/system/what-changed-watcher.service \
    /run/systemd/system/what-changed-watcher.service \
    /usr/local/lib/systemd/system/what-changed-watcher.service \
    /usr/lib/systemd/system/what-changed-watcher.service \
    /lib/systemd/system/what-changed-watcher.service; do
    candidate_path=$(target "$candidate")
    [ -r "$candidate_path" ] || continue
    if grep -q '/usr/local/lib/what-changed-watcher/watcher.py' "$candidate_path"; then
      layout=portable
    elif grep -q '/usr/lib/what-changed-watcher/watcher.py' "$candidate_path"; then
      layout=debian
    else
      continue
    fi
    case "$candidate" in
      /run/*) existing_service= ;;
      *) existing_service=$candidate ;;
    esac
    break
  done
  if [ "$layout" = auto ]; then
    if [ -f "$(target /usr/local/lib/what-changed-watcher/watcher.py)" ]; then
      layout=portable
    elif [ -f "$(target /usr/lib/what-changed-watcher/watcher.py)" ]; then
      layout=debian
    fi
  fi
  if [ "$layout" = auto ]; then
    case "$os_family" in
      debian) layout=debian ;;
      rhel) layout=portable ;;
      *)
        echo "Unsupported or unrecognized operating-system family: ${os_id:-unknown}." >&2
        echo 'Use --layout debian or --layout portable only after reviewing the target paths.' >&2
        exit 1
        ;;
    esac
  fi
fi

case "$layout" in
  debian)
    library=/usr/lib/what-changed-watcher
    service=/lib/systemd/system/what-changed-watcher.service
    ;;
  portable)
    library=/usr/local/lib/what-changed-watcher
    service=/etc/systemd/system/what-changed-watcher.service
    ;;
  *) usage; exit 2 ;;
esac
if [ -n "${existing_service:-}" ]; then
  service=$existing_service
fi

installed_version=
if [ -r "$(target "$library/VERSION")" ]; then
  installed_version=$(tr -d '[:space:]' < "$(target "$library/VERSION")")
fi
version_is_newer() {
  awk -v installed="$1" -v embedded="$2" 'BEGIN {
    split(installed, left, "."); split(embedded, right, ".");
    for (i = 1; i <= 3; i++) {
      if ((left[i] + 0) > (right[i] + 0)) exit 0;
      if ((left[i] + 0) < (right[i] + 0)) exit 1;
    }
    exit 1;
  }'
}
if [ "$installed_version" = "$embedded_version" ]; then
  payload_state=current
elif printf '%s\n' "$installed_version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' \
    && version_is_newer "$installed_version" "$embedded_version"; then
  payload_state=newer
elif [ -f "$(target "$library/watcher.py")" ]; then
  payload_state=outdated
else
  payload_state=not_installed
fi

dependency_command=
case "$os_family" in
  debian) dependency_command='apt-get update && apt-get install -y python3-pymysql' ;;
  rhel)
    if command -v dnf >/dev/null 2>&1; then
      dependency_command='dnf install -y python3-PyMySQL'
    else
      dependency_command='yum install -y python3-PyMySQL'
    fi
    ;;
esac

pymysql_available() {
  if [ "$test_mode" = 1 ]; then
    [ "${test_pymysql:-available}" = available ]
  else
    python3 -c 'import pymysql' >/dev/null 2>&1
  fi
}

install_pymysql_dependency() {
  if pymysql_available; then
    return 0
  fi

  echo 'PyMySQL is required by the WhatChanged watcher.' >&2
  if [ -z "$dependency_command" ]; then
    echo "No automatic PyMySQL installation is available for ${os_id:-this operating system}." >&2
    exit 1
  fi
  echo "Proposed command: $dependency_command" >&2

  answer=
  if [ "$test_mode" = 1 ]; then
    answer=${test_answer:-no}
  elif [ -r /dev/tty ]; then
    printf 'Install PyMySQL now and continue? [y/N] ' >/dev/tty
    IFS= read -r answer </dev/tty || answer=
  fi
  case "$answer" in
    y|Y|yes|YES|Yes)
      if [ "$test_mode" = 1 ]; then
        echo "test_dependency_command=$dependency_command"
        test_pymysql=available
      elif [ "$os_family" = debian ]; then
        apt-get update
        DEBIAN_FRONTEND=noninteractive apt-get install -y python3-pymysql
      elif command -v dnf >/dev/null 2>&1; then
        dnf install -y python3-PyMySQL
      else
        yum install -y python3-PyMySQL
      fi
      ;;
    *)
      echo 'PyMySQL was not installed. Run the proposed command, then run this installer again.' >&2
      exit 1
      ;;
  esac

  if ! pymysql_available; then
    echo 'PyMySQL is still unavailable after the package installation attempt.' >&2
    exit 1
  fi
  echo 'PyMySQL dependency is available.'
}

echo "layout=$layout"
echo "library=$library"
echo "service=$service"

if [ "$check_only" -eq 1 ]; then
  echo 'payload=complete'
  echo "embedded_version=$embedded_version"
  echo "installed_version=${installed_version:-unknown}"
  echo "payload_state=$payload_state"
  if [ "$payload_state" = newer ]; then
    echo 'module_update_required=yes'
  else
    echo "update_command=sudo $module_dir/bin/install-watcher"
  fi
  if pymysql_available; then
    echo 'pymysql=available'
  else
    echo 'pymysql=missing'
    [ -z "$dependency_command" ] || echo "dependency_command=$dependency_command"
  fi
  exit 0
fi
if [ "$(id -u)" -ne 0 ]; then
  echo 'Run this installer as root.' >&2
  exit 1
fi

if [ "$test_mode" != 1 ]; then
  [ -f /etc/freepbx.conf ] || { echo 'FreePBX was not found at /etc/freepbx.conf.' >&2; exit 1; }
  command -v systemctl >/dev/null 2>&1 || { echo 'A systemd-based FreePBX host is required.' >&2; exit 1; }
  command -v php >/dev/null 2>&1 || { echo 'PHP CLI is required.' >&2; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo 'Python 3.6 or newer is required.' >&2; exit 1; }
  python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 6) else 1)' || {
    echo 'Python 3.6 or newer is required.' >&2
    exit 1
  }
fi
install_pymysql_dependency

# Inspect FreePBX's authoritative database and web-root settings before changing
# the host. Remote databases are a supported manual-configuration path and do
# not require a local SQL client.
db_host=
db_port=
db_socket=
db_name=
local_database=0
live_environment=/etc/what-changed-watcher.env
if [ "$test_mode" = 1 ]; then
  freepbx_webroot=${test_webroot:-/var/www/html}
  astetc=${test_astetc:-/etc/asterisk}
  astvarlib=${test_astvarlib:-/var/lib/asterisk}
  db_port=${test_dbport:-3306}
  db_socket=$test_dbsock
else
  description=$(php "$payload/configure-database.php" --describe)
  tab=$(printf '\t')
  old_ifs=$IFS
  IFS=$tab
  set -- $description
  IFS=$old_ifs
  if [ "$#" -ne 7 ]; then
    echo 'Could not determine the FreePBX database connection and web root.' >&2
    exit 1
  fi
  db_host=$1
  db_port=$2
  db_name=$3
  freepbx_webroot=$4
  astetc=$5
  astvarlib=$6
  db_socket=$7
  [ "$db_socket" = - ] && db_socket=
fi
for configured_path in "$freepbx_webroot" "$astetc" "$astvarlib"; do
  case "$configured_path" in
    /*) : ;;
    *) echo 'FreePBX filesystem settings must be absolute paths.' >&2; exit 1 ;;
  esac
done
case "$db_port" in
  ''|*[!0-9]*) echo 'FreePBX AMPDBPORT must be numeric.' >&2; exit 1 ;;
esac
if [ -n "$db_socket" ]; then
  case "$db_socket" in
    /*) : ;;
    *) echo 'FreePBX AMPDBSOCK must be an absolute path.' >&2; exit 1 ;;
  esac
fi
module_path=${freepbx_webroot%/}/admin/modules
state_dir=${astvarlib%/}/pendingchanges-watcher
attribution_dir=${astvarlib%/}/pendingchanges-attribution
attribution_log=$attribution_dir/requests.jsonl
astdb_path=${astvarlib%/}/astdb.sqlite3
echo "freepbx_webroot=$freepbx_webroot"
echo "module_path=$module_path"
echo "asterisk_config=$astetc"
echo "asterisk_variable_data=$astvarlib"
[ -z "$db_socket" ] || echo "database_socket=$db_socket"

if [ "$test_mode" != 1 ] && {
    [ ! -f "$live_environment" ] \
      || grep -q '^DB_PASSWORD=replace-with-generated-secret$' "$live_environment";
  }; then
  case "$db_socket:$db_host" in
    ?*:*|:localhost|:127.0.0.1)
      local_database=1
      if ! command -v mariadb >/dev/null 2>&1 && ! command -v mysql >/dev/null 2>&1; then
        echo 'A MariaDB/MySQL client is required for automatic local database setup.' >&2
        exit 1
      fi
      ;;
  esac
fi

install -d -o root -g root -m 0755 "$(target "$library")"
install -d -o root -g root -m 0755 "$(dirname "$(target "$service")")"
install -d -o root -g root -m 0755 "$(target /usr/sbin)"
install -d -o asterisk -g asterisk -m 0750 "$(target "$state_dir")"
install -d -o asterisk -g asterisk -m 0750 "$(target "$attribution_dir")"

install -m 0644 "$payload/watcher.py" "$(target "$library/watcher.py")"
install -m 0644 "$payload/what-changed-request-audit.php" "$(target "$library/what-changed-request-audit.php")"
install -m 0644 "$payload/configure-database.php" "$(target "$library/configure-database.php")"
install -m 0755 "$payload/what-changed-watcher-configure" "$(target /usr/sbin/what-changed-watcher-configure)"
install -m 0755 "$payload/what-changed-watcher-install-sensor" "$(target /usr/sbin/what-changed-watcher-install-sensor)"

escaped_library=$(printf '%s' "$library" | sed 's/[&|]/\\&/g')
escaped_module_path=$(printf '%s' "$module_path" | sed 's/[&|]/\\&/g')
escaped_astetc=$(printf '%s' "$astetc" | sed 's/[&|]/\\&/g')
escaped_astvarlib=$(printf '%s' "$astvarlib" | sed 's/[&|]/\\&/g')
escaped_state=$(printf '%s' "$state_dir" | sed 's/[&|]/\\&/g')
escaped_attribution=$(printf '%s' "$attribution_dir" | sed 's/[&|]/\\&/g')
sed "s|/usr/local/lib/what-changed-watcher|$escaped_library|g" \
  "$payload/99-what-changed-attribution.ini" > "$(target "$library/99-what-changed-attribution.ini")"
chmod 0644 "$(target "$library/99-what-changed-attribution.ini")"
sed -e "s|/usr/local/lib/what-changed-watcher|$escaped_library|g" \
  -e "s|/var/www/html/admin/modules|$escaped_module_path|g" \
  -e "s|/etc/asterisk|$escaped_astetc|g" \
  -e "s|/var/lib/asterisk/pendingchanges-watcher|$escaped_state|g" \
  -e "s|/var/lib/asterisk/pendingchanges-attribution|$escaped_attribution|g" \
  -e "s|/var/lib/asterisk|$escaped_astvarlib|g" \
  "$payload/what-changed-watcher.service" > "$(target "$service")"
chmod 0644 "$(target "$service")"
install -m 0644 "$(target "$service")" "$(target "$library/what-changed-watcher.service")"

environment=$(target /etc/what-changed-watcher.env)
if [ ! -f "$environment" ]; then
  install -d -o root -g root -m 0755 "$(dirname "$environment")"
  install -o root -g root -m 0600 "$payload/what-changed-watcher.env" "$environment"
fi

replace_environment_setting() {
  setting=$1
  value=$2
  destination=$3
  temporary=${destination}.next.$$
  escaped=$(printf '%s' "$value" | sed 's/[&|]/\\&/g')
  if grep -q "^${setting}=" "$destination"; then
    sed "s|^${setting}=.*|${setting}=${escaped}|" "$destination" > "$temporary"
  else
    { printf '%s=%s\n' "$setting" "$value"; cat "$destination"; } > "$temporary"
  fi
  install -o root -g root -m 0600 "$temporary" "$destination"
  rm -f "$temporary"
}
replace_environment_setting DB_PORT "$db_port" "$environment"
replace_environment_setting DB_SOCKET "$db_socket" "$environment"
replace_environment_setting WATCH_PATH "$astetc" "$environment"
replace_environment_setting MODULE_PATH "$module_path" "$environment"
replace_environment_setting ASTDB_PATH "$astdb_path" "$environment"
replace_environment_setting STATE_DIR "$state_dir" "$environment"
replace_environment_setting ATTRIBUTION_LOG "$attribution_log" "$environment"

if [ "$test_mode" = 1 ]; then
  install -m 0644 "$payload/VERSION" "$(target "$library/VERSION")"
  echo "Watcher payload staged beneath $test_root for validation."
  exit 0
fi

/usr/sbin/what-changed-watcher-configure --paths-only
/usr/sbin/what-changed-watcher-install-sensor
systemctl daemon-reload

start_service=0
if grep -q '^DB_PASSWORD=replace-with-generated-secret$' "$environment"; then
  if [ "$local_database" -eq 1 ]; then
    /usr/sbin/what-changed-watcher-configure
    start_service=1
  else
    systemctl disable --now what-changed-watcher.service >/dev/null 2>&1 || true
    echo "Watcher files installed, but FreePBX uses remote database host '$db_host'."
    echo 'Create a reviewed SELECT-only account, update /etc/what-changed-watcher.env, then enable the service.'
  fi
else
  systemctl enable what-changed-watcher.service
  start_service=1
fi

version_backup=
if [ -f "$library/VERSION" ]; then
  version_backup=/tmp/what-changed-watcher-version.$$
  cp "$library/VERSION" "$version_backup"
fi
install -m 0644 "$payload/VERSION" "$library/VERSION"
if [ "$start_service" -eq 1 ]; then
  if ! systemctl restart what-changed-watcher.service; then
    if [ -n "$version_backup" ]; then
      install -m 0644 "$version_backup" "$library/VERSION"
    else
      rm -f "$library/VERSION"
    fi
    [ -z "$version_backup" ] || rm -f "$version_backup"
    echo 'The watcher service did not restart; the installed version marker was rolled back.' >&2
    exit 1
  fi
  echo 'Watcher service is running with the embedded payload version.'
fi
[ -z "$version_backup" ] || rm -f "$version_backup"
echo 'WhatChanged embedded watcher installation completed.'
