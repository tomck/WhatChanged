#!/usr/bin/env php
<?php
require_once '/etc/freepbx.conf';
$service = FreePBX::Pendingchanges();
$command = isset($argv[1]) ? $argv[1] : 'status';
try {
    if ($command === 'seed') {
        $result = $service->seedBaseline();
    } elseif ($command === 'status') {
        $result = $service->status();
    } elseif ($command === 'feedback') {
        $result = $service->feedback();
    } elseif ($command === 'doctor') {
        $status = $service->status();
        $health = isset($status['watcher_health']) && is_array($status['watcher_health']) ? $status['watcher_health'] : array();
        $payload = isset($health['payload']) && is_array($health['payload'])
            ? $health['payload']
            : array();
        $payloadCurrent = !empty($payload['current']);
        $sensorConfigured = false;
        $sensorCandidates = array('/etc/php.d/99-what-changed-attribution.ini');
        foreach (array('apache2', 'fpm') as $webSapi) {
            $debianCandidates = glob('/etc/php/*/' . $webSapi . '/conf.d/99-what-changed-attribution.ini');
            if (is_array($debianCandidates)) {
                $sensorCandidates = array_merge($sensorCandidates, $debianCandidates);
            }
        }
        foreach ($sensorCandidates as $sensorCandidate) {
            if (!is_readable($sensorCandidate)) {
                continue;
            }
            $sensorConfiguration = file_get_contents($sensorCandidate);
            if (is_string($sensorConfiguration)
                && preg_match('/^\s*auto_prepend_file\s*=\s*([^\r\n]+)$/m', $sensorConfiguration, $matches)
            ) {
                $sensorPath = trim($matches[1], " \t\n\r\0\x0B\"'");
                if ($sensorPath !== '' && is_readable($sensorPath)) {
                    $sensorConfigured = true;
                    break;
                }
            }
        }
        $lines = array(
            'watcher_state=' . (isset($health['state']) ? $health['state'] : 'unknown'),
            'watcher_label=' . (isset($health['label']) ? $health['label'] : 'Unknown'),
            'data_current=' . (!empty($status['data_current']) ? 'yes' : 'no'),
            'coverage_mode=' . (isset($status['coverage_mode']) ? $status['coverage_mode'] : 'unknown'),
            'baseline_provenance=' . (
                isset($status['baseline_provenance']['state'])
                    ? $status['baseline_provenance']['state'] : 'unknown'
            ),
            'sensor_configured=' . ($sensorConfigured ? 'yes' : 'no'),
            'sensor_loaded=not_applicable_cli',
            'sensor_runtime_check=FreePBX_Reports_Pending_Changes_Tripwire',
            'pending_reload=' . (!empty($status['pending']) ? 'yes' : 'no'),
            'watcher_payload_state=' . (isset($payload['state']) ? $payload['state'] : 'unknown'),
            'embedded_watcher_version=' . (
                isset($payload['embedded_version']) ? $payload['embedded_version'] : 'unknown'
            ),
            'installed_watcher_version=' . (
                isset($payload['installed_version']) ? $payload['installed_version'] : 'unknown'
            ),
            'watcher_payload_current=' . ($payloadCurrent ? 'yes' : 'no'),
        );
        if (isset($health['observation_age_seconds'])) {
            $lines[] = 'observation_age_seconds=' . (int) $health['observation_age_seconds'];
        }
        $state = isset($health['state']) ? $health['state'] : '';
        if (!$payloadCurrent) {
            if ((isset($payload['state']) ? $payload['state'] : '') === 'newer') {
                $lines[] = 'module_update_required=yes';
            } else {
                $lines[] = 'watcher_update_command=' . (
                    isset($payload['update_command'])
                        ? $payload['update_command']
                        : 'sudo ' . dirname(__FILE__) . '/install-watcher'
                );
            }
        } elseif ($state === 'not_installed' || $state === 'installed_unconfigured') {
            $lines[] = 'remedy=sudo ' . dirname(__FILE__) . '/install-watcher';
        }
        echo implode(PHP_EOL, $lines) . PHP_EOL;
        $trusted = isset($status['baseline_provenance']['state'])
            && $status['baseline_provenance']['state'] === 'trusted';
        exit(empty($status['data_current']) || !$trusted || !$payloadCurrent ? 2 : 0);
    } else {
        throw new RuntimeException('Usage: pendingchanges [status|seed|feedback|doctor]');
    }
    echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES).PHP_EOL;
} catch (Exception $e) {
    fwrite(STDERR, $e->getMessage().PHP_EOL);
    exit(1);
}
