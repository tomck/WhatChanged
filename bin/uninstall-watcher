#!/bin/sh
# Remove watcher executables installed from the module while preserving local
# evidence, configuration, and the SELECT-only database account.
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo 'Run this uninstaller as root.' >&2
  exit 1
fi

# Remove the web-SAPI configuration and reload every active stack while the
# referenced PHP library still exists. A failure stops here and preserves the
# library, avoiding a host-wide PHP outage from a dangling auto_prepend_file.
module_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
lifecycle=$module_dir/watcher/web-sensor-lifecycle.sh
if [ ! -r "$lifecycle" ]; then
  echo "Watcher uninstall helper is missing: $lifecycle" >&2
  echo 'Reinstall the Pending Changes module archive, then run this command again.' >&2
  exit 1
fi
. "$lifecycle"
if ! what_changed_remove_sensor_configuration; then
  echo 'The sensor ini files were removed, but an active web stack failed validation or reload.' >&2
  echo 'The watcher library was preserved so PHP does not reference a missing file.' >&2
  echo "Correct the reported web-server/PHP error, then rerun: sudo $module_dir/bin/uninstall-watcher" >&2
  exit 1
fi

systemctl disable --now what-changed-watcher.service >/dev/null 2>&1 || true
rm -f /lib/systemd/system/what-changed-watcher.service
rm -f /etc/systemd/system/what-changed-watcher.service
rm -f /usr/sbin/what-changed-watcher-configure
rm -f /usr/sbin/what-changed-watcher-install-sensor
rm -rf /usr/lib/what-changed-watcher /usr/local/lib/what-changed-watcher

systemctl daemon-reload >/dev/null 2>&1 || true

echo 'Watcher executables and web-PHP sensor removed.'
echo 'Evidence, /etc/what-changed-watcher.env, and the database account were preserved.'
